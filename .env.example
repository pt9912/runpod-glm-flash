# Copy to .env (git-ignored), fill in, then load into your shell:
#   set -a; source .env; set +a
# Placeholders only. Never commit real values.

# RunPod API key: used by Terraform and all scripts. Reading works with a read-only key;
# create-pod.sh, pod-start.sh, pod-stop.sh and pod-terminate.sh need write access to Pods (else HTTP 403).
RUNPOD_API_KEY=

# Pod ID printed by create-pod.sh: used by pod-start.sh, pod-stop.sh, pod-terminate.sh, verify-pod.sh and wait-for-ready.sh (proxy URL)
RUNPOD_POD_ID=

# Optional: override the REST API base URL (default https://api.runpod.io/v2)
# RUNPOD_BASE_URL=

# Client side (Claude Code): see the "Claude Code" section in the README
# GLM_URL=https://POD_ID-8000.proxy.runpod.net
# Same value as the RunPod Secret VLLM_API_KEY
VLLM_API_KEY=

# Optional: the Pod pool (start-any.sh / stop-any.sh) = all Pods whose name starts with POOL_PREFIX.
# The pool is read live from your account; no Pod IDs are stored anywhere.
# POOL_PREFIX=glm-5.3-flash-b300
# POOL_MAX=6
# Optional: Network Volume ID for create-pod.sh / start-any.sh (default: terraform/terraform.tfvars)
# NETWORK_VOLUME_ID=
