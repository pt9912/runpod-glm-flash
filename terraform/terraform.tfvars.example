# No secrets belong here.
network_volume_id = "REPLACE_WITH_EXISTING_NETWORK_VOLUME_ID"

# Optional: pin a specific machine. Leave unset so RunPod picks any machine with a free B300.
# machine_id = "REPLACE_WITH_SECURE_B300_MACHINE_ID"

# true  = model is already on the volume, no HF token is sent.
# false = fresh setup: allow downloads and inject the HF_TOKEN secret.
offline_mode = true

# Usually no need to change these:
gpu_type_id = "NVIDIA B300 SXM6 AC"
pod_name    = "glm-5.3-flash-b300"

# Provider 1.0.8 natively targets https://rest.runpod.io/v1; v2 is untested (see README).
runpod_base_url = "https://api.runpod.io/v2"
